# =============================================================================
# Notera - Required Environment Variables
# Copy this file to .env.local and fill in your values.
# ALL variables are required — the app will fail fast with a clear error
# if any are missing.
# =============================================================================

# Supabase PostgreSQL (Transaction mode pooler — port 6543, NOT 5432)
# Find in: Supabase Dashboard > Project Settings > Database > Connection string > Transaction
# Format: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# RunPod Serverless (HeartMuLa music generation)
# Find in: RunPod Dashboard > Serverless > Endpoints > [your endpoint]
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Cloudflare R2 (audio file storage)
# Find in: Cloudflare Dashboard > R2 > Overview > Account ID (top right)
CLOUDFLARE_ACCOUNT_ID=

# R2 API Token credentials
# Find in: Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 Bucket name (create the bucket first in the Cloudflare R2 dashboard)
R2_BUCKET_NAME=music-generator-audio

# Stripe (subscription billing)
# Find in: Stripe Dashboard > Developers > API Keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook Secret
# Find in: Stripe Dashboard > Developers > Webhooks > Signing secret
# Local testing: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create products in Stripe Dashboard > Products)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=
