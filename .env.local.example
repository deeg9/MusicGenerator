# =============================================================================
# Notera - Required Environment Variables
# Copy this file to .env.local and fill in your values.
# ALL variables are required — the app will fail fast with a clear error
# if any are missing.
# =============================================================================

# Supabase PostgreSQL (Transaction mode pooler — port 6543, NOT 5432)
# Find in: Supabase Dashboard > Project Settings > Database > Connection string > Transaction
# Format: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# RunPod Persistent Pod URL (the ACE-Step 1.5 turbo API server)
# Format: https://{POD_ID}-8000.proxy.runpod.net
# Find in: RunPod Dashboard > Pods > [your pod] > Connect > HTTP Service
RUNPOD_URL=

# Cloudflare R2 (audio file storage)
# Find in: Cloudflare Dashboard > R2 > Overview > Account ID (top right)
CLOUDFLARE_ACCOUNT_ID=

# R2 API Token credentials
# Find in: Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create API Token
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 Bucket name (create the bucket first in the Cloudflare R2 dashboard)
R2_BUCKET_NAME=music-generator-audio
